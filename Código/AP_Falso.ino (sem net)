#include <WiFi.h>
#include <esp_wifi.h>

const char* ssid = "Gostoso";
const char* password = "Gostoso123";

byte allowedMac[6] = {0xE5, 0x9D, 0x36, 0xDF, 0x6E, 0x73};

void setup() {
  Serial.begin(115200);
  WiFi.mode(WIFI_AP);
  WiFi.softAP(ssid, password);
  Serial.println("Access Point criado");
}

void loop() {
  wifi_sta_list_t wifi_sta_list;
  esp_wifi_ap_get_sta_list(&wifi_sta_list);

  for (int i = 0; i < wifi_sta_list.num; i++) {
    wifi_sta_info_t station = wifi_sta_list.sta[i];
    bool allowed = memcmp(station.mac, allowedMac, 6) == 0;

    if (!allowed) {
      Serial.print("Dispositivo não autorizado: ");
      for (int j = 0; j < 6; j++) {
        Serial.printf("%02X", station.mac[j]);
        if (j < 5) Serial.print(":");
      }
      Serial.println("A Desconectar...");

      esp_wifi_deauth_sta(i + 1);
    }
  }

  delay(5000);
}
